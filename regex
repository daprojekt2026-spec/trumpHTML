
<!DOCTYPE html>
<html lang="cs">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Trump Post Scoring — Metodika</title>
<style>
  * { box-sizing: border-box; margin: 0; padding: 0; }

  body {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    background: #0f1117;
    color: #e2e8f0;
    padding: 32px 16px;
  }

  .widget {
    max-width: 780px;
    margin: 0 auto;
  }

  .widget-header {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 6px;
  }

  .widget-title {
    font-size: 13px;
    font-weight: 600;
    letter-spacing: .06em;
    text-transform: uppercase;
    color: #94a3b8;
  }

  .badge {
    font-size: 11px;
    font-weight: 700;
    padding: 2px 8px;
    border-radius: 20px;
    letter-spacing: .04em;
  }
  .badge-python { background: #1e3a5f; color: #60a5fa; border: 1px solid #2563eb44; }
  .badge-notebook { background: #1a3326; color: #4ade80; border: 1px solid #16a34a44; }

  /* ── TAB BAR ── */
  .tabs {
    display: flex;
    gap: 0;
    border-bottom: 1px solid #1e293b;
    margin-bottom: 0;
  }

  .tab {
    padding: 9px 18px;
    font-size: 12.5px;
    font-weight: 500;
    color: #64748b;
    cursor: pointer;
    border-bottom: 2px solid transparent;
    transition: color .15s, border-color .15s;
    user-select: none;
    background: none;
    border-top: none;
    border-left: none;
    border-right: none;
    outline: none;
  }
  .tab:hover { color: #94a3b8; }
  .tab.active { color: #e2e8f0; border-bottom-color: #3b82f6; }

  /* ── CODE BLOCK ── */
  .code-wrap {
    background: #0d1117;
    border: 1px solid #1e293b;
    border-top: none;
    border-radius: 0 0 8px 8px;
    position: relative;
  }

  .code-scroll {
    overflow-y: auto;
    height: calc(14 * 1.6em + 24px); /* 14 řádků */
    padding: 14px 0 14px 0;
    scrollbar-width: thin;
    scrollbar-color: #334155 transparent;
  }
  .code-scroll::-webkit-scrollbar { width: 6px; }
  .code-scroll::-webkit-scrollbar-track { background: transparent; }
  .code-scroll::-webkit-scrollbar-thumb { background: #334155; border-radius: 3px; }

  pre {
    font-family: "Fira Code", "Cascadia Code", "JetBrains Mono", "Courier New", monospace;
    font-size: 12.5px;
    line-height: 1.6em;
    padding: 0 20px;
    white-space: pre;
    margin: 0;
    display: none;
  }
  pre.active { display: block; }

  /* ── LINE NUMBERS ── */
  .code-table { border-collapse: collapse; width: 100%; }
  .ln {
    text-align: right;
    padding: 0 14px 0 8px;
    color: #374151;
    user-select: none;
    min-width: 36px;
    font-size: 11.5px;
    vertical-align: top;
    line-height: 1.6em;
  }
  .lc {
    padding: 0 16px 0 0;
    line-height: 1.6em;
    white-space: pre;
    vertical-align: top;
  }

  /* ── SYNTAX COLORS ── */
  .kw  { color: #c792ea; }   /* keywords: def, return, if, for… */
  .fn  { color: #82aaff; }   /* function names */
  .st  { color: #c3e88d; }   /* strings */
  .rx  { color: #f78c6c; }   /* regex patterns */
  .cm  { color: #546e7a; font-style: italic; } /* comments */
  .nm  { color: #f78c6c; }   /* numbers */
  .ct  { color: #ffcb6b; }   /* category constants */
  .op  { color: #89ddff; }   /* operators / brackets */
  .py  { color: #80cbc4; }   /* builtins */

  /* ── COPY BUTTON ── */
  .copy-btn {
    position: absolute;
    top: 10px;
    right: 12px;
    background: #1e293b;
    border: 1px solid #334155;
    color: #94a3b8;
    font-size: 11px;
    padding: 4px 10px;
    border-radius: 5px;
    cursor: pointer;
    transition: background .15s, color .15s;
    z-index: 10;
  }
  .copy-btn:hover { background: #334155; color: #e2e8f0; }

  /* ── FOOTER INFO ── */
  .info-bar {
    display: flex;
    gap: 20px;
    margin-top: 12px;
    flex-wrap: wrap;
  }
  .info-item {
    font-size: 12px;
    color: #64748b;
  }
  .info-item strong { color: #94a3b8; }

  /* ── SCORE TABLE ── */
  .score-table-wrap {
    margin-top: 20px;
    border: 1px solid #1e293b;
    border-radius: 8px;
    overflow: hidden;
  }
  .score-table-title {
    background: #0d1117;
    padding: 10px 16px;
    font-size: 12px;
    font-weight: 600;
    color: #64748b;
    letter-spacing: .05em;
    text-transform: uppercase;
    border-bottom: 1px solid #1e293b;
  }
  table.dist {
    width: 100%;
    border-collapse: collapse;
    font-size: 12.5px;
    background: #0d1117;
  }
  table.dist th {
    padding: 7px 14px;
    text-align: left;
    color: #475569;
    font-weight: 600;
    font-size: 11px;
    letter-spacing: .06em;
    text-transform: uppercase;
    border-bottom: 1px solid #1e293b;
  }
  table.dist td {
    padding: 6px 14px;
    border-bottom: 1px solid #0f172a;
    font-variant-numeric: tabular-nums;
  }
  table.dist tr:last-child td { border-bottom: none; }
  .label-rel { color: #4ade80; font-weight: 600; }
  .label-may { color: #fbbf24; font-weight: 600; }
  .label-irr { color: #64748b; }
  .bar-cell { width: 120px; }
  .bar-bg { background: #1e293b; border-radius: 3px; height: 6px; }
  .bar-fill { height: 6px; border-radius: 3px; }
  .fill-rel { background: #22c55e; }
  .fill-may { background: #f59e0b; }
  .fill-irr { background: #334155; }
</style>
</head>
