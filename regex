      <!-- TAB 2: score_post -->
      <table class="code-table" id="tab-score">
<tr><td class="ln">1</td><td class="lc"><span class="kw">def</span> <span class="fn">score_post</span><span class="op">(</span>text<span class="op">:</span> <span class="py">str</span><span class="op">)</span> <span class="op">-&gt;</span> <span class="py">dict</span><span class="op">:</span></td></tr>
<tr><td class="ln">2</td><td class="lc">    <span class="cm">"""Vrátí klasifikaci a skóre 0–10 pro jeden text."""</span></td></tr>
<tr><td class="ln">3</td><td class="lc">    t <span class="op">=</span> <span class="py">str</span><span class="op">(</span>text<span class="op">).</span><span class="fn">lower</span><span class="op">()</span></td></tr>
<tr><td class="ln">4</td><td class="lc"></td></tr>
<tr><td class="ln">5</td><td class="lc">    <span class="cm"># 1) STOP kontrola</span></td></tr>
<tr><td class="ln">6</td><td class="lc">    stop_category <span class="op">=</span> <span class="kw">None</span></td></tr>
<tr><td class="ln">7</td><td class="lc">    <span class="kw">for</span> pattern, category <span class="kw">in</span> <span class="ct">STOP_RULES</span><span class="op">:</span></td></tr>
<tr><td class="ln">8</td><td class="lc">        match <span class="op">=</span> re<span class="op">.</span><span class="fn">search</span><span class="op">(</span>pattern, t<span class="op">)</span></td></tr>
<tr><td class="ln">9</td><td class="lc">        <span class="kw">if</span> match<span class="op">:</span></td></tr>
<tr><td class="ln">10</td><td class="lc">            stop_category <span class="op">=</span> category</td></tr>
<tr><td class="ln">11</td><td class="lc">            <span class="kw">break</span></td></tr>
<tr><td class="ln">12</td><td class="lc"></td></tr>
<tr><td class="ln">13</td><td class="lc">    override <span class="op">=</span> <span class="py">bool</span><span class="op">(</span>re<span class="op">.</span><span class="fn">search</span><span class="op">(</span><span class="ct">STOP_OVERRIDE</span>, t<span class="op">))</span></td></tr>
<tr><td class="ln">14</td><td class="lc"></td></tr>
<tr><td class="ln">15</td><td class="lc">    <span class="kw">if</span> stop_category <span class="kw">and not</span> override<span class="op">:</span></td></tr>
<tr><td class="ln">16</td><td class="lc">        <span class="kw">return</span> <span class="op">{</span></td></tr>
<tr><td class="ln">17</td><td class="lc">            <span class="st">"type"</span><span class="op">:</span>       <span class="st">"STOP"</span>,</td></tr>
<tr><td class="ln">18</td><td class="lc">            <span class="st">"category"</span><span class="op">:</span>   stop_category,</td></tr>
<tr><td class="ln">19</td><td class="lc">            <span class="st">"score"</span><span class="op">:</span>      <span class="nm">0</span>,</td></tr>
<tr><td class="ln">20</td><td class="lc">            <span class="st">"label"</span><span class="op">:</span>      <span class="st">"irrelevant"</span>,</td></tr>
<tr><td class="ln">21</td><td class="lc">            <span class="st">"categories"</span><span class="op">:</span> stop_category,</td></tr>
<tr><td class="ln">22</td><td class="lc">            <span class="st">"signals"</span><span class="op">:</span>    <span class="py">f</span><span class="st">"STOP:{stop_category}:{match.group()}"</span>,</td></tr>
<tr><td class="ln">23</td><td class="lc">            <span class="st">"all_scores"</span><span class="op">:</span> <span class="op">{}</span></td></tr>
<tr><td class="ln">24</td><td class="lc">        <span class="op">}</span></td></tr>
<tr><td class="ln">25</td><td class="lc"></td></tr>
<tr><td class="ln">26</td><td class="lc">    <span class="cm"># 2) Hlavní pravidla</span></td></tr>
<tr><td class="ln">27</td><td class="lc">    category_scores <span class="op">=</span> <span class="op">{}</span></td></tr>
<tr><td class="ln">28</td><td class="lc">    signals <span class="op">=</span> <span class="op">[]</span></td></tr>
<tr><td class="ln">29</td><td class="lc"></td></tr>
<tr><td class="ln">30</td><td class="lc">    <span class="kw">for</span> pattern, weight, category <span class="kw">in</span> <span class="ct">RULES</span><span class="op">:</span></td></tr>
<tr><td class="ln">31</td><td class="lc">        match <span class="op">=</span> re<span class="op">.</span><span class="fn">search</span><span class="op">(</span>pattern, t<span class="op">)</span></td></tr>
<tr><td class="ln">32</td><td class="lc">        <span class="kw">if</span> match<span class="op">:</span></td></tr>
<tr><td class="ln">33</td><td class="lc">            category_scores<span class="op">[</span>category<span class="op">]</span> <span class="op">=</span> category_scores<span class="op">.</span><span class="fn">get</span><span class="op">(</span>category, <span class="nm">0</span><span class="op">)</span> <span class="op">+</span> weight</td></tr>
<tr><td class="ln">34</td><td class="lc">            signals<span class="op">.</span><span class="fn">append</span><span class="op">(</span><span class="py">f</span><span class="st">"{category}+{weight}:{match.group()}"</span><span class="op">)</span></td></tr>
<tr><td class="ln">35</td><td class="lc"></td></tr>
<tr><td class="ln">36</td><td class="lc">    <span class="cm"># 3) Výpočet celkového skóre (max 10)</span></td></tr>
<tr><td class="ln">37</td><td class="lc">    total_score <span class="op">=</span> <span class="py">min</span><span class="op">(</span><span class="py">sum</span><span class="op">(</span>category_scores<span class="op">.</span><span class="fn">values</span><span class="op">()),</span> <span class="nm">10</span><span class="op">)</span></td></tr>
<tr><td class="ln">38</td><td class="lc"></td></tr>
<tr><td class="ln">39</td><td class="lc">    <span class="cm"># 4) Seřazení kategorií podle skóre</span></td></tr>
<tr><td class="ln">40</td><td class="lc">    sorted_cats <span class="op">=</span> <span class="py">sorted</span><span class="op">(</span>category_scores, <span class="kw">key</span><span class="op">=</span><span class="kw">lambda</span> c<span class="op">:</span> category_scores<span class="op">[</span>c<span class="op">],</span> <span class="kw">reverse</span><span class="op">=</span><span class="kw">True</span><span class="op">)</span></td></tr>
<tr><td class="ln">41</td><td class="lc"></td></tr>
<tr><td class="ln">42</td><td class="lc">    <span class="kw">if</span>   total_score <span class="op">&gt;=</span> <span class="nm">6</span><span class="op">:</span>  label <span class="op">=</span> <span class="st">"relevant"</span></td></tr>
<tr><td class="ln">43</td><td class="lc">    <span class="kw">elif</span> total_score <span class="op">&gt;=</span> <span class="nm">3</span><span class="op">:</span>  label <span class="op">=</span> <span class="st">"maybe"</span></td></tr>
<tr><td class="ln">44</td><td class="lc">    <span class="kw">else</span><span class="op">:</span>                  label <span class="op">=</span> <span class="st">"irrelevant"</span></td></tr>
<tr><td class="ln">45</td><td class="lc"></td></tr>
<tr><td class="ln">46</td><td class="lc">    main_cat <span class="op">=</span> sorted_cats<span class="op">[</span><span class="nm">0</span><span class="op">]</span> <span class="kw">if</span> sorted_cats <span class="kw">else</span> <span class="st">"OTHER"</span></td></tr>
<tr><td class="ln">47</td><td class="lc"></td></tr>
<tr><td class="ln">48</td><td class="lc">    <span class="kw">return</span> <span class="op">{</span></td></tr>
<tr><td class="ln">49</td><td class="lc">        <span class="st">"type"</span><span class="op">:</span>       <span class="st">"MAIN"</span> <span class="kw">if</span> sorted_cats <span class="kw">else</span> <span class="st">"OTHER"</span>,</td></tr>
<tr><td class="ln">50</td><td class="lc">        <span class="st">"category"</span><span class="op">:</span>   main_cat,</td></tr>
<tr><td class="ln">51</td><td class="lc">        <span class="st">"score"</span><span class="op">:</span>      total_score,</td></tr>
<tr><td class="ln">52</td><td class="lc">        <span class="st">"label"</span><span class="op">:</span>      label,</td></tr>
<tr><td class="ln">53</td><td class="lc">        <span class="st">"categories"</span><span class="op">:</span> <span class="st">", "</span><span class="op">.</span><span class="fn">join</span><span class="op">(</span>sorted_cats<span class="op">[:</span><span class="nm">3</span><span class="op">]),</span></td></tr>
<tr><td class="ln">54</td><td class="lc">        <span class="st">"signals"</span><span class="op">:</span>    <span class="st">"; "</span><span class="op">.</span><span class="fn">join</span><span class="op">(</span>signals<span class="op">[:</span><span class="nm">6</span><span class="op">]),</span></td></tr>
<tr><td class="ln">55</td><td class="lc">        <span class="st">"all_scores"</span><span class="op">:</span> category_scores</td></tr>
<tr><td class="ln">56</td><td class="lc">    <span class="op">}</span></td></tr>
      </table>

